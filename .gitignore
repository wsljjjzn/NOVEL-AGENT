# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# 环境（API Key 等密文，绝不入库）
.env
*.local
.venv/
venv/

# 文献（约 13.5GB 语料，不纳入版本控制）
doc/

# 数据（大文件）
data/chunks/
data/embeddings/
data/knowledge/*.db

# 数据修复/重建脚本留下的备份（体积大，可从 project.json 重新生成）
data/projects/*/project.json.bak-*

# 日志
logs/

# 缓存与工具元数据
.pytest_cache/
.reasonix/
.ruff_cache/
.mypy_cache/

# checkpoint 与临时产物（可从数据重建，勿入库）
data/preprocess_checkpoint.json
data/samples/analysis_progress.json

# agent 临时产物
*.tmp
.agent-scratch/

# IDE
.vscode/
.idea/

# Visual Studio
.vs/
*.vsidx

# OS
Thumbs.db
.DS_Store
