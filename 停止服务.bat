@echo off
:: 设置控制台字符集为 UTF-8，防止中文乱码
chcp 65001 >nul
title Novel Studio - 一键停止服务

:: 强制切换工作目录为脚本所在目录
cd /d "%~dp0"

echo ========================================================================
echo              Novel Studio 写作专家系统 · 快速停止与清理工具
echo ========================================================================
echo.
echo 正在扫描并关闭所有占用的后台服务进程与端口...

set "FOUND=0"

:: 1. 查找并强制杀死占用 8000 端口的所有进程 (解决端口被占和文件夹在别处打开问题)
for /f "tokens=5" %%a in ('netstat -aon 2^>nul ^| findstr ":8000" ^| findstr "LISTENING"') do (
    echo [清理] 发现占用 8000 端口的服务进程 [PID: %%a]，正在终止...
    taskkill /F /PID %%a >nul 2>&1
    set "FOUND=1"
)

:: 2. 扫描可能残存的孤儿 uvicorn.exe / python 进程
for /f "tokens=2" %%i in ('tasklist 2^>nul ^| findstr /i "uvicorn"') do (
    echo [清理] 正在终止残留的 uvicorn 进程 [PID: %%i]...
    taskkill /F /PID %%i >nul 2>&1
    set "FOUND=1"
)

echo.
if "%FOUND%"=="1" (
    echo ========================================================================
    echo  [成功] 后端服务已彻底关闭！
    echo  端口 8000 与所有本地文件锁定（JSON/SQLite）已全部释放。
    echo  您现在可以自由重新启动服务、重命名目录、或删除本文件夹。
    echo ========================================================================
) else (
    echo ========================================================================
    echo  [提示] 检查完毕，未发现正在运行的 8000 端口后台服务。
    echo  当前文件夹未被锁定，无任何残留进程。
    echo ========================================================================
)

echo.
echo 窗口将在 3 秒后自动关闭，或按任意键立即关闭...
timeout /t 3 >nul
